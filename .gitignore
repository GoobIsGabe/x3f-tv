# Build outputs
.gradle/
build/
app/build/
*.apk

# IDE / local
.idea/
*.iml
local.properties
.DS_Store
captures/

# Python bytecode from tools/
__pycache__/
*.pyc

# Scratch auth tokens written by firebase/verify.sh runs. Never commit a token:
# it is a real credential for 60 minutes, unlike the API key, which is not one.
.tok
.uid
.hid
.patch.json

# Generated art ORIGINALS (tools/art/raw/), ~22MB of 1024px model output.
# Deliberately not committed: they are reproducible with
#     python tools/art/build.py --force
# for roughly $3, and carrying them would add 22MB to every clone and every CI
# checkout forever, for a reprocessing step that happens rarely.
#
# The one exception is raw/sprites/ — those are BACKUPS OF THE ORIGINAL
# hand-illustrated Bloom and Splash artwork, taken before tools/art/sprites.py
# shrank them in place. They cannot be regenerated by anything. They are kept.
tools/art/raw/*
!tools/art/raw/sprites/
